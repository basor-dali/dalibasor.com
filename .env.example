# ---------------------------------------------------------------------------
# dalibasor.com — environment
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Canonical site URL (no trailing slash). Used for metadata, sitemap, RSS.
NEXT_PUBLIC_SITE_URL=https://dalibasor.com

# Let search engines index the site. Leave unset until the placeholder prose
# has been replaced with real writing — robots.txt and the page meta tags both
# read this, and an indexed placeholder is slow to undo.
# NEXT_PUBLIC_ALLOW_INDEXING=true


# ---------------------------------------------------------------------------
# Photographs
# ---------------------------------------------------------------------------

# Where photographs are served from: "r2" | "cloudinary" | "local"
#
#   r2          Recommended. Every size is generated on your machine at import
#               and uploaded as a static file. No transformation service, no
#               10 MB or 25 MP caps, and R2 never charges for bandwidth.
#   cloudinary  Transforms on demand. Less to set up, metered by credits, and
#               storage is billed every month against the same allowance.
#   local       Development fallback. Serves files straight from /public/media
#               with no resizing. Fine for a fresh clone; not for production.
#
# The importer defaults to this same value, so the site and the tool that fills
# it can never disagree about where photographs live.
NEXT_PUBLIC_MEDIA_PROVIDER=r2


# ---------------------------------------------------------------------------
# Cloudflare R2 — see docs/MEDIA.md for creating the bucket and the token
# ---------------------------------------------------------------------------

# The bucket's public address: the r2.dev URL, or better a custom domain such
# as https://media.dalibasor.com. This one is public — it appears in the src of
# every photograph on the site.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=

# Server/CLI only. Required by the importer, never sent to the browser.
# Create an R2 API token scoped to this one bucket, with Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Prefix every object is stored under, so one bucket can hold other things.
R2_PREFIX=dalibasor


# ---------------------------------------------------------------------------
# Video
# ---------------------------------------------------------------------------

# Video is configured separately from photographs, because doing it properly
# means transcoding and adaptive streaming rather than resizing. Leave this
# unset and video uses Cloudinary whenever Cloudinary is configured below.
# NEXT_PUBLIC_VIDEO_PROVIDER=cloudinary

# Cloudinary — the cloud name is public (it appears in every delivery URL).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Cloudinary — server/CLI only. Required by scripts/media-import.mjs.
# NEVER prefix these with NEXT_PUBLIC_.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Folder inside Cloudinary that everything is uploaded under.
CLOUDINARY_FOLDER=dalibasor


# ---------------------------------------------------------------------------
# Convenience
# ---------------------------------------------------------------------------

# Where the importer reads photos from by default (optional).
# MEDIA_SOURCE_DIR=C:/Users/DaliBasor/PhotosToUpload
